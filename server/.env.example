PORT=3000
# Должны совпадать с docker-compose.yml (POSTGRES_USER / POSTGRES_DB).
# С POSTGRES_HOST_AUTH_METHOD=trust пароль для локального Docker не проверяется — строка ниже всё равно ок.
# На Windows при проблемах замените localhost на 127.0.0.1
DATABASE_URL=postgresql://diplom:diplom@127.0.0.1:5433/diplom
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
